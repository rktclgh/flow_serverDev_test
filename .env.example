# 복사해서 .env 로 쓴다.  cp .env.example .env
# .env 는 커밋하지 않는다.

# ── 앱 ────────────────────────────────────────────────────────────────
APP_PORT=8080

# SPEC §7.0 — 정책 변경 API(고정 토글·커스텀 추가/삭제)를 보호하는 토큰.
# 조회와 업로드는 공개다. 운영에서는 반드시 랜덤 32자 이상으로 교체할 것.
#   openssl rand -hex 32
APP_ADMIN_TOKEN=local-dev-token-change-me

# SPEC §5 — 확장자 없는 파일 허용 여부. 기본 차단.
APP_POLICY_ALLOW_EXTENSIONLESS=false

# SPEC §10.1 — 4계층(Cloudflare 100MB > nginx 12m > Spring 10MB > 브라우저) 중 앱 계층
APP_UPLOAD_MAX_SIZE=10MB

# ── DB ────────────────────────────────────────────────────────────────
POSTGRES_DB=extguard
POSTGRES_USER=extguard
POSTGRES_PASSWORD=extguard
DB_PORT=15432

# ── 오브젝트 스토리지 ─────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=extguard-uploads
MINIO_PORT=19100
MINIO_CONSOLE_PORT=19101
